# ---------- Builder ----------
FROM node:24-bookworm-slim AS builder

WORKDIR /app

ENV pnpm_config_node_linker=isolated
ENV pnpm_config_package_import_method=copy

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       python3 \
       git \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY src/server/package.json ./src/server/package.json

RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm --filter ./src/server run build:fastify

FROM node:24-bookworm-slim AS runner

WORKDIR /app/src/server

ENV NODE_ENV=production

COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/src/server/node_modules ./node_modules

COPY --from=builder /app/src/server/package.json ./package.json

COPY --from=builder /app/src/server/dist ./dist

EXPOSE 3001

CMD ["node", "dist/src/server/index.js"]